# Environnement virtuel
venv/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Variables d'environnement
.env

# VS Code
.vscode/

# Modèles : versionnés à la demande explicite du propriétaire du projet.
# 142 Mo au total (48 Mo de .pt, 96 Mo d'exports OpenVINO), chaque fichier bien
# sous la limite de 100 Mo par fichier de GitHub.
#
# Les dossiers *_openvino_model sont DÉRIVÉS des .pt : `scripts/export_openvino.py`
# les régénère en quelques minutes. Ils sont inclus pour qu'un clone soit
# immédiatement exécutable, mais ils sont aussi liés à la version d'OpenVINO
# installée — après une mise à jour majeure, les réexporter.

# Base de données
*.db
*.sqlite3
*.db-shm
*.db-wal

# Etat runtime : regenere en continu par le pipeline
data/live/
data/health.json

# Logs
logs/
*.log

# Clips vidéo & snapshots
clips/
snapshots/

# Sauvegardes et jeux de données exportés (volumineux, reconstructibles)
backups/
datasets/
data/benchmarks/
videos/

# Logs de compilation OpenVINO
kernel.errors.txt

# OS
.DS_Store
Thumbs.db