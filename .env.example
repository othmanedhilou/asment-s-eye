# Bot Telegram (créé via @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Destinataires des alertes, séparés par des virgules.
# Le PREMIER reçoit toutes les alertes (superviseur) ;
# les suivants ne reçoivent que les alertes CRITIQUES (feu, fumée, arc, chute).
# Pour un groupe Telegram, utiliser l'id du groupe (négatif, ex: -1001234567890).
TELEGRAM_CHAT_IDS=chat_id_superviseur,chat_id_agent2,chat_id_groupe_securite
